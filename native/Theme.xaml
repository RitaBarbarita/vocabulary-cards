<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="Silver" Color="#C0C0C0"/>
 <ControlTemplate x:Key="FlatButton" TargetType="Button"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Arial"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="#C0C0C0"/></Style>
 <Style TargetType="Button">
  <Setter Property="Background" Value="#C0C0C0"/><Setter Property="Foreground" Value="Black"/><Setter Property="Padding" Value="6,3"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="MinHeight" Value="24"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="outer" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="1,1,0,0" SnapsToDevicePixels="True">
    <Border x:Name="edge" BorderBrush="#404040" BorderThickness="0,0,1,1"><Border x:Name="inner" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0"><Border BorderBrush="#808080" BorderThickness="0,0,1,1"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border></Border></Border>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="outer" Property="BorderBrush" Value="#404040"/><Setter TargetName="edge" Property="BorderBrush" Value="White"/><Setter TargetName="inner" Property="BorderBrush" Value="#808080"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#808080"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="inner" Property="BorderBrush" Value="Black"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="Black"/><Setter Property="BorderBrush" Value="#808080"/><Setter Property="BorderThickness" Value="2,2,1,1"/><Setter Property="Padding" Value="3,2"/><Setter Property="MinHeight" Value="23"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#000080"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="#808080" BorderThickness="1,1,0,0"><Border BorderBrush="White" BorderThickness="0,0,1,1"><Border BorderBrush="#404040" BorderThickness="1,1,0,0"><Border BorderBrush="#DFDFDF" BorderThickness="0,0,1,1"><Grid><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/><TextBlock x:Name="watermark" Text="{TemplateBinding Tag}" Foreground="#808080" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/></Grid></Border></Border></Border></Border><ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="watermark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="watermark" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="23"/><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="4,2"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="White" BorderBrush="#808080" BorderThickness="1,1,0,0"><Border BorderBrush="White" BorderThickness="0,0,1,1"><Border BorderBrush="#404040" BorderThickness="1,1,0,0"><Border BorderBrush="#DFDFDF" BorderThickness="0,0,1,1"><ContentPresenter Margin="4,2,24,2" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" IsHitTestVisible="False"/></Border></Border></Border></Border><ToggleButton x:Name="DropDownToggle" ClickMode="Press" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Border HorizontalAlignment="Right" Width="18" Margin="2" Background="#C0C0C0" BorderBrush="White" BorderThickness="1,1,0,0"><Border BorderBrush="#404040" BorderThickness="0,0,1,1"><Polygon Points="0,0 7,0 3.5,4" Fill="Black" Width="7" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Border></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="White" BorderBrush="Black" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"><ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="True"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="4,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="item" Background="White" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="item" Property="Background" Value="#000080"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,3,7,3"/><Setter Property="Foreground" Value="Black"/></Style>
 <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#808080"/><Setter Property="GridLinesVisibility" Value="All"/><Setter Property="HorizontalGridLinesBrush" Value="#DFDFDF"/><Setter Property="VerticalGridLinesBrush" Value="#DFDFDF"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F4F4F4"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/></Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#C0C0C0"/><Setter Property="BorderBrush" Value="White"/><Setter Property="BorderThickness" Value="1,1,0,0"/><Setter Property="Padding" Value="5,4"/><Setter Property="FontWeight" Value="Bold"/></Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="#FFFFE1"/><Setter Property="BorderBrush" Value="Black"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/></Style>
</ResourceDictionary>
