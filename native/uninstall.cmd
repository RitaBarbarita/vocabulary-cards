@echo off
set "VOCABULARY_DATABASE_INSTALL_DIR=%~dp0"
powershell.exe -NoProfile -WindowStyle Hidden -Command "$base=[Environment]::GetFolderPath('LocalApplicationData'); $target=[IO.Path]::GetFullPath($env:VOCABULARY_DATABASE_INSTALL_DIR).TrimEnd([IO.Path]::DirectorySeparatorChar); $allowed=@([IO.Path]::Combine($base,'Programs','Vocabulary Database'),[IO.Path]::Combine($base,'Programs','English Vocab DB')); if($target -notin $allowed){exit 1}; foreach($place in @('Programs','DesktopDirectory')){foreach($name in @('Vocabulary Database','English Vocab DB')){Remove-Item -LiteralPath ([IO.Path]::Combine([Environment]::GetFolderPath($place),$name+'.lnk')) -Force -ErrorAction SilentlyContinue}}; Remove-Item -LiteralPath 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Uninstall\EnglishVocabDB' -Recurse -Force -ErrorAction SilentlyContinue; Start-Sleep -Seconds 2; Remove-Item -LiteralPath $target -Recurse -Force -ErrorAction SilentlyContinue"
exit /b
